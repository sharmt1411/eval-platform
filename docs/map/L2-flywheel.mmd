    remediator["数据修复引擎\nbackend/app/engine/remediator.py:UniversalDataRemediator"]
  end

  slicer["渐进切题引擎\nbackend/app/engine/slicer.py:ProgressiveContextSlicer"]
  deduplicator["去重防稀释引擎\nbackend/app/engine/deduplicator.py:DatasetDeduplicator"]
